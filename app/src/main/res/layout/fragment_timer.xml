<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TimerFragment">

    <LinearLayout
        android:id="@+id/timer_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/guideline_timer1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <TextView
            android:id="@+id/tv_timer_minute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="00"
            android:textSize="72sp" />

        <TextView
            android:id="@+id/tv_timer_second"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text=":00"
            android:textSize="72sp" />

        <TextView
            android:id="@+id/tv_timer_millisecond"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text=".00"
            android:textSize="48sp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="12dp"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/timer_rv_laps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/guideline_timer_btn"
        app:layout_constraintTop_toBottomOf="@id/guideline_timer1"
        tools:listitem="@layout/rv_item_lap" />

    <TextView
        android:id="@+id/timer_no_laps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/timer_no_laps"
        android:textSize="16sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintTop_toTopOf="@id/timer_rv_laps"
        app:layout_constraintBottom_toBottomOf="@id/timer_rv_laps"
        app:layout_constraintStart_toStartOf="@id/timer_rv_laps"
        app:layout_constraintEnd_toEndOf="@id/timer_rv_laps" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_timer_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.7" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_timer1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.35" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_timer_start_pause"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:text="@string/timer_btn_start"
        android:textSize="18sp"
        android:textStyle="bold"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.TrackRunning.Circle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guideline_timer_btn" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_timer_lap_reset"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:text="@string/timer_btn_lap"
        android:enabled="false"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.TrackRunning.Circle"
        app:layout_constraintTop_toTopOf="@id/btn_timer_start_pause"
        app:layout_constraintBottom_toBottomOf="@id/btn_timer_start_pause"
        app:layout_constraintRight_toLeftOf="@id/btn_timer_start_pause"
        app:layout_constraintLeft_toLeftOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
